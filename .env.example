# .env.example — copy to .env.local and fill in real values. Never commit secrets.

# Public URL of your Supabase project (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key — server-only, bypasses RLS; keep secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter API key for AI-assisted report generation
OPENROUTER_API_KEY=your-openrouter-api-key

# Shared secret guarding the cron endpoints (must match the scheduler caller)
CRON_SECRET=your-cron-secret

# n8n webhook URL for notification dispatch (reminders, etc.)
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/notifications

# Shared secret sent with n8n webhook requests for verification
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# n8n webhook URL for FRA/assessment AI processing
N8N_ASSESSMENT_WEBHOOK_URL=https://your-n8n-instance/webhook/assessment

# Canonical public site URL used to build absolute links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fire-safety-platform.vercel.app
