# 888 Safety — environment variables
# Copy to .env.local for development; set the same keys in your host (e.g. Vercel)
# for production. NEVER commit real values. NODE_ENV and VERCEL_URL are set
# automatically by the platform — do not define them manually.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project: https://lksxdpgkbiuorjdvebdz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://lksxdpgkbiuorjdvebdz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public anon key (safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=            # SECRET — server only, bypasses RLS. Never expose.

# ── App URL (required in production) ─────────────────────────────────────────
# Used for invite / set-password / password-reset email links. Falls back to
# http://localhost:3000 locally. MUST be the real domain in production —
# invite/reset emails embed "<NEXT_PUBLIC_SITE_URL>/auth/confirm?token_hash=…"
# links, which verify server-side via verifyOtp (the Supabase redirect-URL
# allowlist is NOT involved; only OTP link expiry applies).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI report generation (required in production) ────────────────────────────
# Without this, draftProposalScope / report generation throw in production.
OPENROUTER_API_KEY=

# ── Scheduled jobs / cron (required for the cron routes) ─────────────────────
# Sent as "Authorization: Bearer <CRON_SECRET>" by the scheduler caller.
CRON_SECRET=

# ── Transactional email (Resend) — required for all customer email ───────────
# Invites, password/set-password links, expiry alerts, report-ready, proposal
# signing, contract-issued etc. are sent directly via Resend from the verified
# merlinsafetysystem.com domain. In production a missing RESEND_API_KEY
# makes dispatchNotification() return {ok:false}; in dev it logs and skips.
RESEND_API_KEY=                       # Resend API key (dashboard → API keys)
EMAIL_FROM="Merlin Safety System <notifications@merlinsafetysystem.com>"  # verified sender
EMAIL_REPLY_TO=888fst@proton.me       # replies land in the Proton inbox (optional)
EMAIL_BRAND_NAME=Merlin Safety System # shown in email header/footer (optional)

# ── n8n bridge (partner automation only — NOT customer email) ────────────────
# Now used ONLY for the three client_form_* events (Finley's n8n Switch) and the
# separate assessment-submitted report workflow. Customer email no longer routes
# through here.
N8N_WEBHOOK_URL=                      # client_form_* event webhook (partner automation)
N8N_WEBHOOK_SECRET=                   # shared secret for the event webhook
N8N_ASSESSMENT_WEBHOOK_URL=           # assessment-submitted webhook (fired on submit)

# ── PayPal (hours top-up checkout) ───────────────────────────────────────────
# The whole billing/checkout flow is gated behind PAYPAL_ENABLED. When unset or
# "false", the client billing page shows packages but the Pay button is disabled
# ("Payments coming soon") and no PayPal API calls are made. Set "true" to go live.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=                     # REST app client id (from the PayPal developer dashboard)
PAYPAL_CLIENT_SECRET=                 # SECRET — server only. Never expose to the browser.
PAYPAL_MODE=sandbox                   # "sandbox" for testing, "live" for production
